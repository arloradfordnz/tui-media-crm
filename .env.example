NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service-role key — server-only, NEVER expose to the browser. Required: the
# public portal/proposal pages and cron jobs read/write through this key after
# verifying the token in the URL. Without it those pages return "unavailable".
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_APP_URL="https://dashboard.tuimedia.nz"
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Tui Media <noreply@tuimedia.nz>"

# Secret appended to the calendar subscription URL so the .ics feed can be read
# without a login session (calendar apps send no cookies). Any long random string.
CALENDAR_FEED_SECRET=""

# Shared secret for Vercel cron routes (morning brief, portal reminders, health).
CRON_SECRET=""
BRIEFING_TOKEN=""

# Comma-separated admin IPs — suppresses self-view notification emails.
ADMIN_IPS=""

# Cloudflare R2 (deliverables storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tui-media-deliverables

# SMS assistant (Twilio). Account SID + Auth Token from the Twilio console.
# TWILIO_PHONE_NUMBER is the number Twilio gave you (E.164, e.g. +15551234567) —
# NZ numbers can't be provisioned for SMS on Twilio, so this will be a US/AU
# number; texting to/from your own NZ mobile still works fine internationally.
# OWNER_PHONE_NUMBER is your own mobile in E.164 (e.g. +64211234567) — the
# only number the assistant will text or accept commands from.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=
