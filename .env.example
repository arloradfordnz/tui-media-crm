NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service-role key — server-only, NEVER expose to the browser. Required: the
# public portal/proposal pages and cron jobs read/write through this key after
# verifying the token in the URL. Without it those pages return "unavailable".
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_APP_URL="https://dashboard.tuimedia.nz"
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Tui Media <noreply@tuimedia.nz>"

# Secret appended to the calendar subscription URL so the .ics feed can be read
# without a login session (calendar apps send no cookies). Any long random string.
CALENDAR_FEED_SECRET=""

# Shared secret for Vercel cron routes (morning brief, portal reminders, health).
CRON_SECRET=""
BRIEFING_TOKEN=""

# Comma-separated admin IPs — suppresses self-view notification emails.
ADMIN_IPS=""

# Cloudflare R2 (deliverables storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tui-media-deliverables

# Telegram assistant. Bot token from @BotFather (Telegram app > search
# BotFather > /newbot). OWNER_TELEGRAM_CHAT_ID is your personal chat id with
# the bot — the only chat the assistant will message or accept commands
# from (find it via the bot's getUpdates after messaging it once).
# TELEGRAM_WEBHOOK_SECRET is any long random string, registered with
# Telegram's setWebhook call and echoed back on every inbound request so we
# can verify it's really Telegram calling.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Read-only IMAP access to hello@tuimedia.nz, for the assistant's email
# awareness (envelope data only — subject/sender/date — never message
# bodies, and never marks anything as read). Same credentials Apple Mail
# uses for this account; get them from Mail > Settings > Accounts, or your
# hosting provider's control panel.
EMAIL_IMAP_HOST=mail.tuimedia.nz
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=hello@tuimedia.nz
EMAIL_IMAP_PASSWORD=
